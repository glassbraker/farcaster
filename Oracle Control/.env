# Copy to .env and fill in your values
RPC_URL=http://block.techiegogo.com:8545
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# VRF-based contract (RaceParimutuelETH_VRF) address after deploy:
CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# Coordinator (Mock or real). For local, set to your MockVRFCoordinatorV2 address:
VRF_COORDINATOR=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Foundry artifact paths (ABI). Adjust as needed after `forge build`:
# e.g. ./out/RaceParimutuelETH_VRF.sol/RaceParimutuelETH_VRF.json
ARTIFACT_RACE=./out/RaceParimutuelETH_VRF.sol/RaceParimutuelETH_VRF.json
# e.g. ./out/MockVRFCoordinatorV2.sol/MockVRFCoordinatorV2.json
ARTIFACT_MOCK=./out/MockVRFCoordinatorV2.sol/MockVRFCoordinatorV2.json
